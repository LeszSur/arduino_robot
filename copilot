static void printFloatLat(float val, bool valid, int len, int prec)
{
  if (!valid)
  {
    while (len-- > 1)
    lcd.setCursor(0, 0);
    lcd.print('*');
    //Serial.print('*');
    //Serial.print(' ');
  }
  else
  {
    //Serial.print(val, prec);
    lcd.setCursor(0, 0);
    lcd.print(val, prec);
    int vi = abs((int)val);
    int flen = prec + (val < 0.0 ? 2 : 1); // . and -
    flen += vi >= 1000 ? 4 : vi >= 100 ? 3 : vi >= 10 ? 2 : 1;
    for (int i=flen; i<len; ++i){
    //Serial.print(' ');
    }
  }
}

